<!DOCTYPE html>
<html <%= platform_identifier %>>
  <head>
    <title><%= page_title %></title>
    <%= viewport_meta_tag %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind v4: aponta para application.css %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-black text-white flex flex-col <%= "hotwire-native" if turbo_native_app? %>">
    <div class="fixed z-100 w-full">
      <header class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 bg-gradient-to-r from-black via-fuchsia-700 to-red-600">
        <div class="flex items-center space-x-2">
          <span class="text-2xl font-bold text-white">TikTokClone</span>
        </div>
        <% if authenticated? %>
        <nav class="flex items-center space-x-4">
          <%= link_to 'Feeds', root_path,
                class: 'px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700' %>
          <%= button_to "Sign Out", session_path, method: :delete,
                class: 'px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700' %>
        </nav>
        <% end %>
      </header>
    </div>

    <main class="flex-1 container mx-auto px-4 py-8 flex items-center justify-center">
      <%= yield %>
    </main>

    <footer class="fixed bottom-0 left-0 w-full bg-gray-900 py-3 shadow-lg flex justify-center items-center">
      <span>&copy; <%=Date.today.year%> TikTok Clone. All rights reserved.</span>
    </footer>

  </body>
</html>
