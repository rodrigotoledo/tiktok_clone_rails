
<div class="flex flex-col items-center min-h-screen bg-black pt-20 pb-16 px-2 sm:px-4">
  <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white mb-4 sm:mb-6 md:mb-8 tracking-tight text-center">TikTok Feed</h1>
  <div class="w-full max-w-lg space-y-4 sm:space-y-6 md:space-y-10">
    <% @posts.each do |post| %>
      <div class="bg-gray-900 rounded-2xl sm:rounded-3xl shadow-2xl border-2 sm:border-4 border-fuchsia-700 overflow-hidden">
        <div class="flex items-center justify-between px-3 sm:px-4 md:px-6 pt-3 sm:pt-4 md:pt-6 gap-2">
          <span class="font-bold text-fuchsia-400 text-sm sm:text-base md:text-lg truncate flex-1"><%= post.user.email_address %></span>
          <span class="text-xs text-gray-400 whitespace-nowrap"><%= post.created_at.strftime('%b %d, %Y %H:%M') %></span>
        </div>
        <div class="px-3 sm:px-4 md:px-6 pt-3 sm:pt-4 pb-2">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-white mb-2 break-words"><%= post.title %></h2>
          <p class="text-sm sm:text-base text-gray-300 mb-3 sm:mb-4 break-words"><%= post.body %></p>
          <% if post.media_file.attached? %>
            <div class="flex justify-center mb-3 sm:mb-4 w-full overflow-hidden">
              <% if post.photo_post? %>
                <%= render partial: "posts/photo_post", locals: { post: post } %>
              <% elsif post.video_post? %>
                <%= render partial: "posts/video_post", locals: { post: post } %>
              <% elsif post.audio_post? %>
                <%= render partial: "posts/audio_post", locals: { post: post } %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="bg-gray-800 px-3 sm:px-4 md:px-6 py-3 sm:py-4 rounded-b-2xl sm:rounded-b-3xl">
          <h3 class="text-base sm:text-lg font-bold text-fuchsia-400 mb-2">Comments</h3>
          <%= turbo_stream_from post, "comments" %>
          <div id="<%=post.id%>_comments" class='max-h-32 sm:max-h-40 overflow-y-auto mb-2 scrollbar-thin space-y-2'>
            <% post.comments.order(created_at: :desc).each do |comment| %>
              <%=render partial: 'comments/comment', locals: {comment: comment} %>
            <% end %>
          </div>
          <%= form_with model:[post,Comment.new], data: { turbo: true, controller: "reset-form", action: "turbo:submit-end->reset-form#reset" } do |form| %>
            <div class="flex items-center gap-2">
              <%= form.text_field :body, placeholder: "Add a comment...", class: "flex-1 min-w-0 px-3 sm:px-4 py-2 text-sm sm:text-base rounded-full bg-gray-900 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-700",
              data: {
                controller: "reset-form",
                action: "turbo:submit-end->reset-form#reset"
              } %>
              <%= form.submit "Comment", class: "px-3 sm:px-4 py-2 text-sm sm:text-base rounded-full bg-fuchsia-700 text-white font-bold hover:bg-fuchsia-800 transition whitespace-nowrap", data: { action: "click->reset-form#submit" } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
