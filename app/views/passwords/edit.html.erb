<div class="min-w-1/3 max-w-md mx-auto bg-gray-900 rounded-xl shadow-lg p-8 border border-fuchsia-700">
  <h1 class="text-3xl font-bold text-center text-white mb-6">Update Your Password</h1>
  <% if flash[:alert] %>
    <div class="mb-4 text-red-400"><%= flash[:alert] %></div>
  <% end %>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="mb-4">
      <%= form.label :password, class: "block text-white mb-2" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "w-full px-4 py-2 rounded-full bg-gray-800 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-700" %>
    </div>
    <div class="mb-4">
      <%= form.label :passwpassword_confirmationord, class: "block text-white mb-2" %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "Enter new password", maxlength: 72, class: "w-full px-4 py-2 rounded-full bg-gray-800 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-700" %>
    </div>
    <div>
      <%= form.submit "Email reset instructions", class: "w-full py-2 rounded-full bg-fuchsia-700 text-white font-bold hover:bg-fuchsia-800 transition" %>
    </div>
  <% end %>

  <div class="mt-4 text-center flex space-x-4">
    <%= link_to "Sign In", new_session_path,
          class: "text-fuchsia-400 hover:underline" %>
    <%= link_to "Sign Up", sign_up_path,
          class: "text-fuchsia-400 hover:underline" %>
  </div>
</div>
